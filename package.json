{
  "name": "mail-tracker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "oxlint --type-aware --deny-warnings",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "fix": "oxlint --type-aware --fix && oxfmt --write .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web",
    "test": "bun test --pass-with-no-tests",
    "dup": "jscpd src mailspring-plugin/src web/src --threshold 0 --min-lines 5 --min-tokens 80 --ignore '**/__tests__/**,src/networks.json,**/*.d.ts,web/src/components/ui/**,web/src/components/patterns/**,web/src/*.css'",
    "check": "bun run lint && bun run format:check && bun run typecheck && bun run build:web && bun run test && bun run dup && bun run build:plugin",
    "refresh:networks": "bun scripts/refresh-networks.ts",
    "compose": "bun src/cli/compose.ts",
    "sync-sent": "bun src/cli/sync-sent.ts",
    "build:plugin": "bun build mailspring-plugin/src/main.ts --outfile mailspring-plugin/lib/main.js --target node --format cjs --external mailspring-exports",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "build:web": "vite build --config web/vite.config.ts",
    "dev:web": "vite --config web/vite.config.ts"
  },
  "dependencies": {
    "hono": "4.13.17",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@base-ui/react": "1.9.0",
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource/instrument-serif": "5.3.0",
    "@happy-dom/global-registrator": "21.0.4",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-table": "8.21.3",
    "@types/bun": "1.4.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "class-variance-authority": "0.7.1",
    "cn": "0.4.0",
    "jscpd": "5.3.0",
    "lucide-react": "1.60.0",
    "oxfmt": "0.66.0",
    "oxlint": "1.81.0",
    "oxlint-plugin-complexity": "2.1.8",
    "oxlint-tsgolint": "7.0.2001",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "ultracite": "7.10.8",
    "vite": "8.3.4",
    "wrangler": "4.160.0"
  }
}
